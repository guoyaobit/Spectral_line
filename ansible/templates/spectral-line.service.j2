[Unit]
Description=Spectral line DPDK/CUDA receiver
Wants=network-online.target
After=network-online.target local-fs.target
ConditionFileIsExecutable={{ spectral_line_install_dir }}/{{ spectral_line_build_dir }}/7mm
ConditionPathExists={{ spectral_line_install_dir }}/config.yaml

[Service]
Type=simple
User=root
Group=root
WorkingDirectory={{ spectral_line_install_dir }}
EnvironmentFile=-/etc/default/spectral-line
ExecStart={{ spectral_line_install_dir }}/{{ spectral_line_build_dir }}/7mm
StandardOutput=journal
StandardError=journal
Restart=no
# The receiver has no graceful signal shutdown path. Kill every worker
# immediately so coordinated cluster stops do not wait on CUDA/DPDK threads.
KillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=2
KillMode=control-group
LimitMEMLOCK=infinity
TasksMax=infinity
UMask=0022

[Install]
WantedBy=multi-user.target
